# Mock is the default. Set a NEW rotated key locally; never commit credentials.
AI_MODE=mock
GLM_API_KEY=
GLM_MODEL=glm-5.3
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:3001
# Demo browser login is fixed admin/admin; local synthetic data only.
# Optional API script bearer token (does not disable demo login):
APP_TOKEN=
# See README before enabling remote access. Local single-user use only by default.
# Conservative CPU-only defaults for a 16-core / 32 GB target machine.
WORKER_CONCURRENCY=2
OMP_THREAD_LIMIT=2
MAX_UPLOAD_MB=20
MAX_PAGES=20
MAX_QUEUE=32
CPU_LIMIT=8
MEM_LIMIT=12g
MAX_OCR_PAGES=8
EXTRACTION_TIMEOUT_MS=25000
