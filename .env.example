# Mock is the default. Set a NEW rotated key locally; never commit credentials.
AI_MODE=mock
GLM_API_KEY=
GLM_MODEL=glm-5.3
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
# Demo browser login is fixed admin/admin; local synthetic data only.
# Optional API script bearer token (does not disable demo login):
APP_TOKEN=
# See README before enabling remote access. Local single-user use only by default.
# Conservative CPU-only defaults for a 16-core / 32 GB target machine.
WORKER_CONCURRENCY=2
OMP_THREAD_LIMIT=2
MAX_UPLOAD_MB=20
MAX_PAGES=20
MAX_QUEUE=32
CPU_LIMIT=8
MEM_LIMIT=12g
MAX_OCR_PAGES=8
EXTRACTION_TIMEOUT_MS=25000

# File transcription is independent of AI_MODE/GLM_MODEL medical interpretation.
# Default local never sends files externally. Each glm upload still needs consent.
PARSING_MODE=local
GLM_FILE_PROVIDER=live
GLM_FILE_API_KEY=
GLM_FILE_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_FILE_TIMEOUT_MS=60000
# Medical interpretation endpoint; Coding Plan is not a production app API license.
GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
