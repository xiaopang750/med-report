{
  "name": "med-report",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"bun --watch server/index.ts\" \"vite\"",
    "start": "bun server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "openapi:generate": "bun -e 'import {openapi} from \"./server/openapi\"; await Bun.write(\"openapi.json\", JSON.stringify(openapi,null,2)+\"\\n\");'"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "swagger-ui-dist": "^5.21.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
